# =====================================================================
#  omni_skeleton  .gitattributes
#  目的：统一换行符，避免 Windows / Linux 之间出现"整文件级假 diff"
# =====================================================================

# 默认：交给 Git 自动识别文本，仓库内与工作区一律使用 LF
* text=auto eol=lf

# ---------- 明确的文本文件 ----------
*.c      text eol=lf
*.h      text eol=lf
*.cpp    text eol=lf
*.hpp    text eol=lf
*.s      text eol=lf
*.cmake  text eol=lf
CMakeLists.txt text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.txt    text eol=lf
*.ioc    text eol=lf
*.ld     text eol=lf
*.ps1    text eol=crlf

# ---------- 二进制文件：禁止任何转换与文本 diff ----------
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.elf    binary
*.bin    binary
*.hex    binary
*.exe    binary
*.o      binary
*.a      binary
*.su     binary
*.map    binary
